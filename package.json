{
  "name": "kinora",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @kinora/server --filter @kinora/web --filter @kinora/tv dev",
    "start": "corepack pnpm --filter @kinora/server start",
    "test": "corepack pnpm --filter @kinora/server --filter @kinora/tv-shell --filter @kinora/client test",
    "typecheck": "corepack pnpm --filter @kinora/server --filter @kinora/web --filter @kinora/tv --filter @kinora/tv-shell typecheck",
    "build": "corepack pnpm --filter @kinora/web --filter @kinora/tv --filter @kinora/tv-shell build",
    "tv:shell": "corepack pnpm --filter @kinora/tv-shell build",
    "tv:package:tizen": "node scripts/tv-package-tizen.mjs",
    "tv:package:webos": "node scripts/tv-package-webos.mjs",
    "tv:package:android": "node scripts/tv-package-android.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  }
}
